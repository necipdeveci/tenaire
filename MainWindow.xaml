<Window x:Class="Tenaire.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tenaire"
        Title="Tenaire" Width="920" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Baslik cubugu -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="OnMinimizeClicked" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnCloseClicked" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource Red}">
                        <Ellipse Width="8" Height="8" Fill="White" />
                    </Border>
                    <TextBlock Text="Tenaire" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- Icerik -->
            <Grid Grid.Row="1" Margin="20,6,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sol: telefon, kalite, kayit -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="_dot" Width="9" Height="9" VerticalAlignment="Center" />
                                    <TextBlock x:Name="_device" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="_status" Style="{StaticResource Note}" Margin="0,8,0,0" MinHeight="36" />
                                <ComboBox x:Name="_deviceList" Style="{StaticResource Combo}" Margin="0,8,0,0" Visibility="Collapsed" SelectionChanged="OnDeviceListChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="118">
                                <TextBlock x:Name="_temperature" FontSize="30" FontWeight="SemiBold" TextAlignment="Right" />
                                <TextBlock x:Name="_battery" Style="{StaticResource Note}" TextAlignment="Right" TextWrapping="NoWrap" />
                                <TextBlock x:Name="_delta" Style="{StaticResource Note}" TextAlignment="Right" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="Görüntü kalitesi" Style="{StaticResource Caption}" />
                            <Border Background="{StaticResource Inset}" CornerRadius="11" Padding="4" Margin="0,10,0,0">
                                <UniformGrid x:Name="_profileHost" Rows="1" />
                            </Border>
                            <TextBlock x:Name="_hint" Style="{StaticResource Note}" Margin="0,10,0,0" MinHeight="36" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource CardBox}">
                        <StackPanel>
                            <Border Background="{StaticResource Inset}" CornerRadius="11" Padding="4">
                                <UniformGrid x:Name="_modeHost" Rows="1">
                                    <RadioButton x:Name="_modeRecord" GroupName="mode" Style="{StaticResource Segment}" Content="Kayıt" Checked="OnModeChanged" />
                                    <RadioButton x:Name="_modeLive" GroupName="mode" Style="{StaticResource Segment}" Content="Canlı Yayın" Checked="OnModeChanged" />
                                    <RadioButton x:Name="_modeWindow" GroupName="mode" Style="{StaticResource Segment}" Content="Pencere" Checked="OnModeChanged" />
                                </UniformGrid>
                            </Border>

                            <StackPanel x:Name="_recordPanel">
                                <CheckBox x:Name="_record" Style="{StaticResource Toggle}" Content="Bilgisayara kaydet" Margin="0,14,0,0" Click="OnRecordToggled" />
                                <CheckBox x:Name="_gameAudio" Style="{StaticResource Toggle}" Content="Oyun sesini videoya ekle" Margin="0,12,0,0" />
                                <CheckBox x:Name="_microphone" Style="{StaticResource Toggle}" Content="Mikrofonu ayrı dosyaya kaydet" Margin="0,12,0,0" />
                            </StackPanel>

                            <StackPanel x:Name="_windowPanel" Visibility="Collapsed">
                                <CheckBox x:Name="_windowGameAudio" Style="{StaticResource Toggle}" Content="Oyun sesini bilgisayarda çal" Margin="0,14,0,0" />
                                <CheckBox x:Name="_windowMicrophone" Style="{StaticResource Toggle}" Content="Mikrofonu bilgisayarda çal" Margin="0,12,0,0" />
                                <CheckBox x:Name="_windowRecord" Style="{StaticResource Toggle}" Content="Aynı anda video kaydı al" Margin="0,12,0,0" />
                                <TextBlock Style="{StaticResource Note}" Margin="0,12,0,0"
                                           Text="Yayın programınıza &quot;Tenaire Yansıtma&quot; penceresini görüntü, Tenaire uygulamasını ses kaynağı olarak ekleyin." />
                            </StackPanel>

                            <StackPanel x:Name="_livePanel" Visibility="Collapsed">
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Platform" Style="{StaticResource Note}" Margin="0,0,0,6" />
                                        <ComboBox x:Name="_livePlatform" Style="{StaticResource Combo}" SelectionChanged="OnLivePlatformChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Bit hızı (kbps)" Style="{StaticResource Note}" Margin="0,0,0,6" />
                                        <local:NumberBox x:Name="_liveBitrate" Minimum="1000" Maximum="20000" Step="500" Width="104" Height="36" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="_liveUrlPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock Text="Sunucu adresi (rtmp veya rtmps)" Style="{StaticResource Note}" Margin="0,0,0,6" />
                                    <TextBox x:Name="_liveUrl" Style="{StaticResource Field}" />
                                </StackPanel>
                                <TextBlock Text="Yayın anahtarı" Style="{StaticResource Note}" Margin="0,12,0,6" />
                                <PasswordBox x:Name="_liveKey" Style="{StaticResource Secret}" />
                                <CheckBox x:Name="_liveGameAudio" Style="{StaticResource Toggle}" Content="Oyun sesini yayına ekle" Margin="0,14,0,0" />
                                <CheckBox x:Name="_liveMicrophone" Style="{StaticResource Toggle}" Content="Mikrofonu yayına ekle" Margin="0,12,0,0" />
                                <CheckBox x:Name="_liveRecord" Style="{StaticResource Toggle}" Content="Yayını bilgisayara da kaydet" Margin="0,12,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Sag: ses -->
                <Border Grid.Column="2" Style="{StaticResource CardBox}">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="_test" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Click="OnTestClicked" />
                            <TextBlock Text="Ses" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="Mikrofon kaynağı" Style="{StaticResource Note}" Margin="0,12,0,6" />
                        <ComboBox x:Name="_microphoneSource" Style="{StaticResource Combo}"
                                  SelectionChanged="OnMicrophoneSourceChanged" DropDownOpened="OnMicrophoneDropDownOpened" />
                        <CheckBox x:Name="_echoCancellation" Style="{StaticResource Toggle}" Content="Yankı engelleme (telefon mikrofonu)" Margin="0,12,0,0" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Oyun" FontWeight="SemiBold" />
                            <TextBlock x:Name="_gameReadout" Grid.Column="1" Foreground="{StaticResource Muted}" />
                        </Grid>
                        <local:LevelMeter x:Name="_gameLevel" Height="28" Margin="0,8,0,0" />
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="dB" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <local:NumberBox x:Name="_gameDb" DockPanel.Dock="Right" Decimals="1" Step="0.5" Margin="14,0,0,0" />
                            <Slider x:Name="_gameSlider" Style="{StaticResource LevelSlider}" VerticalAlignment="Center" />
                        </DockPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mikrofon" FontWeight="SemiBold" />
                            <TextBlock x:Name="_microphoneReadout" Grid.Column="1" Foreground="{StaticResource Muted}" />
                        </Grid>
                        <local:LevelMeter x:Name="_microphoneLevel" Height="28" Margin="0,8,0,0" />
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="dB" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <local:NumberBox x:Name="_microphoneDb" DockPanel.Dock="Right" Decimals="1" Step="0.5" Margin="14,0,0,0" />
                            <Slider x:Name="_microphoneSlider" Style="{StaticResource LevelSlider}" VerticalAlignment="Center" />
                        </DockPanel>

                        <DockPanel Margin="0,18,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="ms" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <local:NumberBox x:Name="_delay" DockPanel.Dock="Right" Minimum="0" Maximum="5000" Step="10" />
                            <TextBlock Text="Mikrofon gecikmesi" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                   Text="Yayında seviyeler anında uygulanır. Kayıtta birleştirirken uygulanır, ham dosyalar değişmez." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Alt cubuk -->
            <Grid Grid.Row="2" Margin="20,16,20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="_tip" Style="{StaticResource Note}" VerticalAlignment="Center" />
                <Button x:Name="_openFolder" Grid.Column="1" Style="{StaticResource QuietButton}" Click="OnOpenFolderClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" />
                        <TextBlock Text="Klasörü aç" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="_merge" Grid.Column="2" Style="{StaticResource ActionButton}" Margin="8,0,0,0" MinWidth="196" Click="OnMergeClicked">
                    <TextBlock x:Name="_mergeText" />
                </Button>
                <Button x:Name="_start" Grid.Column="3" Style="{StaticResource RecordButton}" Margin="10,0,0,0" MinWidth="190" Click="OnStartClicked">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="_startDot" Width="11" Height="11" Fill="White" VerticalAlignment="Center" />
                        <Rectangle x:Name="_startSquare" Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{StaticResource Red}" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="_startText" Margin="10,0,0,0" FontSize="14.5" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
